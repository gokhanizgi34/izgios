APP_NAME="İZGİOS"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://app.izgios.com

APP_LOCALE=tr
APP_FALLBACK_LOCALE=tr
APP_TIMEZONE=Europe/Istanbul

LOG_CHANNEL=stack
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=izgios_production
DB_USERNAME=izgios_app
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=public

MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=info@izgios.com
MAIL_FROM_NAME="${APP_NAME}"

# Sağlayıcı anahtarları yalnızca canlı sunucunun .env dosyasında tutulur.
# Bu dosyayı veya .env dosyasını GitHub'a eklemeyin.
OPENAI_API_KEY=
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
SMS_PROVIDER=
SMS_API_KEY=
